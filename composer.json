{
    "name": "whilesmart/eloquent-client-credentials",
    "description": "Add client credentials authentication to any Eloquent model",
    "package-version": "0.1.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "WhileSmart",
            "email": "dev@whilesmart.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "cviebrock/eloquent-sluggable": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.22",
        "fakerphp/faker": "^1.24",
        "zircote/swagger-php": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "Whilesmart\\EloquentClientCredentials\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/",
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Whilesmart\\EloquentClientCredentials\\EloquentClientCredentialsServiceProvider"
            ]
        }
    },
    "scripts": {
        "pint": "./vendor/bin/pint",
        "pint:test": "./vendor/bin/pint --test",
        "test": "@php vendor/bin/phpunit",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
